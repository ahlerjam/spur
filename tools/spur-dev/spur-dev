#!/bin/bash
# Fester Zugang zum spur-Entwicklungsstack. `spur-dev install` legt eine Kopie außerhalb
# des Repos ab (lokal ~/.local/bin, in der Cloud /usr/local/bin). Builder rufen nur diese
# Kopie auf und bekommen so kein freies docker; Änderungen hier wirken erst nach einem
# erneuten `install` durch einen Menschen.
set -euo pipefail
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/spur-dev"
MOUNTS="services/web/app services/web/frontend services/web/modules services/web/config services/web/locales services/document-updater libraries tools/migrations server-ce/nginx/vhost-extras/overleaf"

install_self() {
  local here bin arch root
  here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
  if [ "${2:-}" != --cloud ]; then
    # Hauptordner des Repos, auch wenn install aus einem Worktree läuft.
    root=$(cd "$here" && cd "$(git rev-parse --git-common-dir)/.." && pwd -P)
  fi
  case "$(uname -m)" in arm64|aarch64) arch=arm64 ;; *) arch=amd64 ;; esac
  if [ "$(id -u)" = 0 ]; then bin=/usr/local/bin; else bin="$HOME/.local/bin"; fi
  mkdir -p "$bin" "$CONF"
  install -m 755 "$here/spur-dev" "$bin/spur-dev"
  sed "s#@ARCH@#$arch#" "$here/compose.yml" > "$CONF/compose.yml"
  if [ ! -s "$CONF/secrets.env" ]; then
    (umask 077; printf 'OVERLEAF_INVITE_TOKEN_SECRET=%s\n' "$(openssl rand -hex 32)" > "$CONF/secrets.env")
  fi
  if [ "${2:-}" = --cloud ]; then
    # Cloud-VM ohne Sandbox: jeder Klon und Worktree auf der VM ist erlaubt.
    echo / > "$CONF/roots"
  else
    # Erlaubte Quellordner: dieses Repo und die slice-Worktrees daneben.
    printf '%s\n%s/\n' "$root" "${XDG_CACHE_HOME:-$HOME/.cache}/slice/$(basename "$root")" > "$CONF/roots"
  fi
  echo "spur-dev installiert: $bin/spur-dev, Image spur-dev:$arch"
}
[ "${1:-}" = install ] && { install_self "$@"; exit 0; }

[ -s "$CONF/compose.yml" ] || { echo "spur-dev: erst tools/spur-dev/spur-dev install ausführen" >&2; exit 2; }
SRC=$(git rev-parse --show-toplevel 2>/dev/null || true)
ok=""
while IFS= read -r r; do
  case "$r" in */) [[ "$SRC/" == "$r"* ]] && ok=1 ;; *) [ "$SRC" = "$r" ] && ok=1 ;; esac
done < "$CONF/roots"
[ -n "$SRC" ] && [ -n "$ok" ] || { echo "spur-dev: nur im spur-Repo oder einem slice-Worktree erlaubt" >&2; exit 2; }
SRC=$(cd "$SRC" && pwd -P)
export SPUR_SRC="$SRC"

check_mounts() {
  # Kein eingehängter Pfad darf per Symlink aus dem Worktree hinausführen.
  local m real
  for m in $MOUNTS; do
    real=$(cd "$SRC/$m" 2>/dev/null && pwd -P) || { echo "spur-dev: $m fehlt im Worktree" >&2; exit 2; }
    [ "$real" = "$SRC/$m" ] || { echo "spur-dev: $m ist ein Symlink, abgelehnt" >&2; exit 2; }
  done
}
docker_bereit() {
  docker info >/dev/null 2>&1 && return 0
  # Cloud-VM: der Docker-Dienst läuft nach einem Neustart der VM nicht von selbst.
  if [ "${CLAUDE_CODE_REMOTE:-}" = true ]; then
    (service docker start >/dev/null 2>&1 || nohup dockerd >/var/log/dockerd.log 2>&1 &) || true
    for _ in $(seq 1 30); do docker info >/dev/null 2>&1 && return 0; sleep 1; done
  fi
  echo "spur-dev: Docker läuft nicht" >&2; exit 2
}
dc() { docker compose -f "$CONF/compose.yml" "$@"; }
web() { docker exec -i spur-dev-web bash -lc "set -o pipefail; cd /overleaf/services/web && $1"; }
wait_up() {
  for _ in $(seq 1 60); do
    if [ "$(docker inspect -f '{{.State.Running}}' spur-dev-web 2>/dev/null)" != true ]; then
      echo "spur-dev: Container läuft nicht, letzte Ausgabe:" >&2; docker logs --tail 60 spur-dev-web >&2 || true; return 1
    fi
    [ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 http://localhost:8080/status || true)" = 200 ] && { echo "spur läuft auf http://localhost:8080"; return 0; }
    sleep 3
  done
  echo "spur-dev: Stack antwortet nicht, siehe: spur-dev logs" >&2; return 1
}
# Ohne -i: webpack braucht keine Eingabe, und ein offenes stdin brach den Build nach einem Neustart
# des Containers gelegentlich mit Exit 129 ab.
build() { docker exec spur-dev-web bash -lc 'cd /overleaf/services/web && yarn run lezer-latex:generate >/dev/null 2>&1 && { yarn run webpack:production > /tmp/webpack.log 2>&1; rc=$?; grep compiled /tmp/webpack.log || tail -20 /tmp/webpack.log; exit $rc; }'; }
restart() {
  docker exec spur-dev-web bash -c 'sv restart web-overleaf web-api-overleaf document-updater-overleaf' | sed 's/:.*//' | sort -u | tr '\n' ' '; echo
  docker exec spur-dev-web sv reload nginx >/dev/null 2>&1 || docker exec spur-dev-web sv restart nginx >/dev/null
  wait_up
}
# Kurz nach dem Start des Containers bricht webpack gelegentlich mit Exit 129 (SIGHUP) ab,
# Ursache unklar; ein zweiter Versuch läuft durch.
build_sicher() {
  local n
  for n in 1 2 3; do
    build && return 0
    echo "Build abgebrochen (Versuch $n), neuer Versuch in 30 s"; sleep 30
  done
  return 1
}
# Ein frischer Checkout hat die generierte Lezer-Grammatik noch nicht; ohne sie startet web nicht.
grammatik() { docker exec spur-dev-web bash -lc 'cd /overleaf/services/web && yarn run lezer-latex:generate >/dev/null 2>&1'; }
# Testschalter (gitignoriert): ohne Datei ginge die Prüfung an die echte Crossref-API.
schalter_anlegen() {
  local f="$SRC/services/web/modules/spur/dev-schalter.json"
  [ -d "${f%/*}" ] || return 0
  [ -e "$f" ] || printf '{"SPUR_PAPER_API_BASE": "http://127.0.0.1/spur/dev/crossref"}\n' > "$f"
}
up() { docker_bereit; check_mounts; schalter_anlegen; dc up -d --force-recreate web >/dev/null; grammatik; wait_up; build_sicher; restart; }
ensure() {
  local cur
  docker_bereit
  cur=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/overleaf/services/web/modules"}}{{.Source}}{{end}}{{end}}' spur-dev-web 2>/dev/null || true)
  # Docker Desktop meldet Pfade mit dem Präfix /host_mnt.
  cur=${cur#/host_mnt}
  [ "$cur" = "$SRC/services/web/modules" ] || { echo "Worktree gewechselt oder Stack aus, Stack wird neu erzeugt."; up; }
}
du_geaendert() {
  # Ohne upstream-Branch (flacher Klon in der Cloud) laufen die Tests immer.
  local basis
  basis=$(git -C "$SRC" merge-base HEAD origin/ext-ce 2>/dev/null) || return 0
  ! git -C "$SRC" diff --quiet "$basis" -- services/document-updater libraries/ranges-tracker
}
# Overleafs Suiten in einem eigenen Container aus dem Dev-Image, mit dem Quellstand von $2 (Standard:
# dieser Worktree). Der laufende Stack bleibt unberührt; nur Mongo und Redis werden mitbenutzt.
# Die Auswertung (tools/tests/upstream.mjs) kommt immer aus diesem Worktree, auch für main und ext-ce.
upstream_lauf() {
  local suite=$1 quelle=$2 name=$3 e
  local erg="$UPSTREAM_ERG/$name"
  local -a vol=(-v "$SRC/tools/tests:/spur-tests:ro" -v "$erg:/ergebnis" -v "$quelle/tsconfig.backend.json:/overleaf/tsconfig.backend.json:ro")
  mkdir -p "$erg"
  # Alles aus services/web, was die Stack-Definition nicht schon einhängt (test, types, Konfigurationen …).
  for e in $(git -C "$quelle" ls-tree --name-only HEAD services/web/); do
    case " $MOUNTS " in *" $e "*) continue ;; esac
    vol+=(-v "$quelle/$e:/overleaf/$e:ro")
  done
  SPUR_SRC="$quelle" dc run --rm --no-deps -T --entrypoint bash -e SPUR_PROTOKOLL="$erg" "${vol[@]}" web \
    -lc "node /spur-tests/upstream.mjs $suite --ergebnis /ergebnis ${4:+$(printf '%q ' "${@:4}")}"
}
UPSTREAM_SUITEN="web frontend du"
upstream_suite() { case " $UPSTREAM_SUITEN " in *" $1 "*) return 0 ;; esac; return 1; }
upstream() {
  local s q r rc=0 cache="${XDG_CACHE_HOME:-$HOME/.cache}/spur-dev" b
  local -a suiten fehlt=()
  local hilfe="spur-dev upstream web|frontend|du [datei …] | alle | vergleich [web|frontend|du …]"
  # Argumente vor dem Docker-Start prüfen; ein unbekannter Name liefe sonst nirgends und endete mit Exit 0.
  case "${1:-}" in
    alle) [ $# -eq 1 ] || { echo "spur-dev upstream alle nimmt keine Dateien. $hilfe" >&2; return 2; } ;;
    vergleich) for s in "${@:2}"; do
                 upstream_suite "$s" || { echo "spur-dev upstream vergleich: unbekannte Suite „$s“. $hilfe" >&2; return 2; }
               done ;;
    *) upstream_suite "${1:-}" || { echo "$hilfe" >&2; return 2; } ;;
  esac
  UPSTREAM_ERG="$cache/upstream"
  docker_bereit; check_mounts
  dc --profile upstream up -d --wait mongo redis redis-test >/dev/null
  case "$1" in
    # Der schwerste Exit-Code zählt: 2 (nichts gelaufen) darf nicht von einer späteren 1 überdeckt werden.
    alle) for s in $UPSTREAM_SUITEN; do
            upstream_lauf "$s" "$SRC" aktuell || { r=$?; [ "$r" -le "$rc" ] || rc=$r; }
          done
          return "$rc" ;;
    vergleich)
      # main ist Overleaf, ext-ce overleaf-cep; die spur-Seite ist dieser Worktree (agent mit den Änderungen
      # dieses Zweigs), damit die Liste zum Code passt, mit dem sie committet wird.
      git -C "$SRC" fetch -q origin main ext-ce
      for b in main ext-ce; do
        if [ -d "$cache/vergleich/$b" ]; then git -C "$cache/vergleich/$b" checkout -q --detach "origin/$b"
        else git -C "$SRC" worktree add -q --detach "$cache/vergleich/$b" "origin/$b"; fi
      done
      # Ohne Argument alle Suiten; sonst nur die genannten, die übrigen Ergebnisse bleiben stehen.
      suiten=("${@:2}"); [ ${#suiten[@]} -gt 0 ] || read -ra suiten <<< "$UPSTREAM_SUITEN"
      for s in "${suiten[@]}"; do
        for q in main:"$cache/vergleich/main" ext-ce:"$cache/vergleich/ext-ce" agent:"$SRC"; do
          upstream_lauf "$s" "${q#*:}" "${q%%:*}" --nur-ergebnis || fehlt+=("$s auf ${q%%:*}")
        done
      done
      # Ohne Ergebnis eines Stands behält die Liste die alten Einträge dieser Suite; das muss rot enden.
      SPUR_SRC="$SRC" dc run --rm --no-deps -T --entrypoint bash \
        -v "$SRC/tools/tests:/spur-tests" -v "$UPSTREAM_ERG:/ergebnis" web \
        -lc 'node /spur-tests/upstream.mjs liste --ergebnis /ergebnis' || rc=$?
      if [ ${#fehlt[@]} -gt 0 ]; then
        echo "spur-dev upstream vergleich: ohne Ergebnis: ${fehlt[*]}; deren Einträge blieben unverändert" >&2
        return 2
      fi
      return "$rc" ;;
    *) upstream_lauf "$1" "$SRC" aktuell "${@:2}" ;;
  esac
}
case "${1:-}" in
  up)      up ;;
  upstream) shift; upstream "$@" ;;
  down)    dc --profile upstream down ;;
  reset)   dc --profile upstream down -v ;;
  status)  dc ps --format '{{.Service}} {{.State}}' ;;
  reload)  ensure; build_sicher; restart ;;
  restart) ensure; restart ;;
  test)    ensure
           rc=0
           if [ -d "$SRC/services/web/modules/spur" ]; then
             # Abdeckung nur für die spur-Serverlogik; dev/ (Fakes für Tests) zählt nicht.
             web "yarn run vitest run modules/spur --coverage.enabled --coverage.provider=istanbul \
               --coverage.include='modules/spur/app/src/**' --coverage.exclude='modules/spur/app/src/dev/**' \
               --coverage.reporter=text --coverage.reporter=text-summary --coverage.reportsDirectory=/tmp/spur-coverage \
               --coverage.thresholds.lines=80 2>&1 | grep -vE '^ +[^|]*\| +100 \| +100 \| +100 \| +100 \|' | tail -60" || rc=$?
           else echo "Noch keine spur-Tests."; fi
           if du_geaendert; then
             docker exec -i spur-dev-web bash -lc 'set -o pipefail; cd /overleaf/services/document-updater && TEST_NAME_PATTERN= yarn run test:unit 2>&1 | tail -8' || rc=$?
           fi
           exit "$rc" ;;
  run)     ensure; shift; web "node $(printf '%q ' "$@")" ;;
  mongo)   docker exec -i spur-dev-mongo mongosh sharelatex --quiet --eval "${2:?Ausdruck fehlt}" ;;
  dump)    docker exec spur-dev-mongo mongodump --quiet --db sharelatex --archive=/data/db/spur-dump.archive
           docker exec spur-dev-web tar czf /var/lib/overleaf/spur-data.tgz --ignore-failed-read -C /var/lib/overleaf data/spur 2>/dev/null || true; echo gesichert ;;
  restore) docker exec spur-dev-mongo mongorestore --quiet --drop --archive=/data/db/spur-dump.archive
           docker exec spur-dev-web bash -c 'rm -rf /var/lib/overleaf/data/spur; [ -s /var/lib/overleaf/spur-data.tgz ] && tar xzf /var/lib/overleaf/spur-data.tgz -C /var/lib/overleaf || true'; echo wiederhergestellt ;;
  migrate) ensure; shift; docker exec -i spur-dev-web bash -lc "cd /overleaf/tools/migrations && yarn run east $(printf '%q ' "$@")" ;;
  user)    web "node modules/server-ce-scripts/scripts/create-user.mjs --email='${2:?E-Mail fehlt}' --admin 2>&1" | tr -d '\r' | grep -m1 -oE 'token=[0-9a-f]+&user_id=[0-9a-f]+' | sed 's#^#http://localhost:8080/user/activate?#' ;;
  logs)    docker exec spur-dev-web tail -n "${3:-60}" "/var/log/overleaf/${2:-web}.log" 2>/dev/null || docker logs --tail "${3:-60}" spur-dev-web ;;
  *) echo "Befehle: install up down reset status reload restart test upstream run mongo dump restore migrate user logs" >&2; exit 2 ;;
esac
