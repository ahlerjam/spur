#!/usr/bin/env bash
# Lädt ein PDF aus legalen freien Quellen (arXiv, Unpaywall, Europe PMC). Gibt nur den Dateipfad aus.
set -u

hilfe() {
  cat <<'TXT'
Aufruf: spur-pdf-holen <DOI> [ziel]

Lädt ein frei verfügbares PDF in den Ordner [ziel] (Standard: .) und gibt den Pfad der
Datei aus. Bei arXiv-DOIs zuerst arXiv, dann alle freien Fundorte aus Unpaywall
(Repositorien vor Verlagsseiten), zuletzt Europe PMC.

Exit 0: PDF geladen. Exit 1: keine freie Version gefunden oder Download fehlgeschlagen.
Exit 2: Aufruf falsch oder keine Mail. Exit 3: keine PDF-Datei, eine Adresse lieferte eine
Webseite statt des PDFs (oft Bot-Schutz); dann hilft der Browser (Skill spur-pdf-holen).

Umgebung:
  UNPAYWALL_EMAIL        Mail für die Unpaywall-API (sonst git config user.email)
  SPUR_UNPAYWALL_BASE    Standard https://api.unpaywall.org
  SPUR_ARXIV_BASE        Standard https://arxiv.org
  SPUR_EUROPEPMC_BASE    Standard https://www.ebi.ac.uk/europepmc
TXT
}

case "${1:-}" in
  -h|--help) hilfe; exit 0 ;;
  "") hilfe >&2; exit 2 ;;
esac

doi=$1
ziel=${2:-.}
unpaywall=${SPUR_UNPAYWALL_BASE:-https://api.unpaywall.org}
arxiv=${SPUR_ARXIV_BASE:-https://arxiv.org}
europepmc=${SPUR_EUROPEPMC_BASE:-https://www.ebi.ac.uk/europepmc}
unpaywall=${unpaywall%/}
arxiv=${arxiv%/}
europepmc=${europepmc%/}

doi=${doi#https://doi.org/}
doi=${doi#http://doi.org/}
doi=${doi#doi:}

mkdir -p "$ziel" || { echo "Zielordner nicht anlegbar: $ziel" >&2; exit 1; }
name=$(printf '%s' "$doi" | sed 's/[^A-Za-z0-9._-]/_/g; s/^\.*//')
[ -n "$name" ] || { echo "Ungültige DOI" >&2; exit 2; }
datei="${ziel%/}/$name.pdf"
tmp=$(mktemp "${ziel%/}/.spur-pdf.XXXXXX") || { echo "Keine temporäre Datei im Zielordner" >&2; exit 1; }
trap 'rm -f "$tmp"' EXIT

# Gibt 0 zurück, wenn die Datei geladen wurde und mit %PDF- beginnt.
# Setzt $fehler auf "keine PDF-Datei" bzw. die Ursache des Abbruchs.
laden() {
  fehler=
  if ! curl -sSL -f --connect-timeout 20 --max-time 120 -A "spur-pdf-holen" -o "$tmp" -- "$1" 2>/dev/null; then
    fehler="Download fehlgeschlagen"
    return 1
  fi
  if [ "$(head -c 5 "$tmp")" != "%PDF-" ]; then
    fehler="keine PDF-Datei"
    return 1
  fi
}

fertig() {
  mv "$tmp" "$datei" || exit 1
  printf '%s\n' "$datei"
  exit 0
}

fehler=
case "$doi" in
  10.48550/[aA][rR][xX][iI][vV].*)
    id=${doi#10.48550/[aA][rR][xX][iI][vV].}
    laden "$arxiv/pdf/$id" && fertig
    ;;
esac

mail=${UNPAYWALL_EMAIL:-}
[ -n "$mail" ] || mail=$(git config user.email 2>/dev/null || true)
if [ -z "$mail" ]; then
  echo "Keine Mail für Unpaywall: UNPAYWALL_EMAIL setzen oder git config user.email" >&2
  exit 2
fi

# Nur Zeichen kodieren, die in einem Pfad oder einer Query stören
doi_url=$(printf '%s' "$doi" | sed 's/%/%25/g; s/ /%20/g; s/?/%3F/g; s/#/%23/g; s/&/%26/g')

# Werte von <feld> aus den flachen JSON-Objekten {…} auf stdin, die jedes weitere Muster enthalten.
werte() {
  local feld=$1 objekte muster
  shift
  objekte=$(tr -d '\n' | grep -oE '\{[^{}]*\}')
  for muster in "$@"; do objekte=$(printf '%s\n' "$objekte" | grep -E "$muster"); done
  printf '%s\n' "$objekte" | grep -oE "\"$feld\": *\"[^\"]*\"" | sed -E "s/^\"$feld\": *\"//; s/\"\$//" | sed 's/\\u0026/\&/g; s#\\/#/#g'
}

# Versucht jede Adresse der Liste (eine je Zeile, Dubletten nur einmal) und endet beim ersten PDF.
gesehen=$'\n'
html=0
gruende=
versuchen() {
  local url
  while IFS= read -r url; do
    [ -n "$url" ] || continue
    case "$gesehen" in *$'\n'"$url"$'\n'*) continue ;; esac
    gesehen+="$url"$'\n'
    laden "$url" && fertig
    [ "$fehler" = "keine PDF-Datei" ] && html=1
    gruende+="  $fehler: $url"$'\n'
  done <<< "$1"
}

# Unpaywall: alle freien Fundorte, Repositorien zuerst, denn Verlagsseiten weisen Skripte öfter ab.
if antwort=$(curl -sS -f --max-time 60 -A "spur-pdf-holen" "$unpaywall/v2/$doi_url?email=$mail" 2>/dev/null); then
  versuchen "$(printf '%s' "$antwort" | werte url_for_pdf '"host_type": *"repository"')"
  versuchen "$(printf '%s' "$antwort" | werte url_for_pdf)"
fi
# Danach Europe PMC: das offene PDF aus der Volltextliste zur DOI.
if antwort=$(curl -sS -f --max-time 60 -A "spur-pdf-holen" "$europepmc/webservices/rest/search?query=DOI:$doi_url&format=json&resultType=core" 2>/dev/null); then
  versuchen "$(printf '%s' "$antwort" | werte url '"availabilityCode": *"OA"' '"documentStyle": *"pdf"')"
fi

if [ -z "$gruende" ]; then
  echo "keine freie Version gefunden" >&2
  exit 1
fi
if [ "$html" = 1 ]; then
  printf 'keine PDF-Datei: die freien Adressen liefern eine Webseite statt des PDFs (oft Bot-Schutz).\n%s' "$gruende" >&2
  exit 3
fi
printf 'Download fehlgeschlagen:\n%s' "$gruende" >&2
exit 1
