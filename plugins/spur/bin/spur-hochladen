#!/usr/bin/env bash
# Lädt Dateien einzeln über einen Einmal-Link zu spur hoch, eine Ausgabezeile je Datei.
set -u

hilfe() {
  cat <<'TXT'
Aufruf: spur-hochladen <link> <datei>... [--doi <doi>] [--titel <titel>]
         [--autoren "Nachname, Vorname; …"] [--jahr <jahr>] [--art <art>] [--institution <name>] [--url <adresse>]
       spur-hochladen <link> <bild> --projektdatei <pfad im projekt>

Lädt jede Datei einzeln an den Upload-Link hoch (aus dem MCP-Werkzeug source_upload_link).
Mit --projektdatei und einem Link aus file_upload_link legt spur genau eine Datei (PNG, JPEG oder PDF,
bis 10 MB) unter diesem Pfad im Projekt an, etwa abbildungen/diagramm.pdf; Ausgabe: <bild>: Datei <pfad>.
Die Optionen gelten für alle Dateien des Aufrufs und dürfen vor oder nach den Dateien stehen.
Für Quellen ohne DOI (Abschlussarbeit, Report, Working Paper): --titel mit --autoren, --jahr,
--art (thesis, report, working_paper, book, misc), --institution und --url; spur legt daraus den
.bib-Eintrag an. Mit --doi kommen die Metadaten von der DOI. Jede Datei bekommt einen
.bib-Eintrag; ohne Metadaten ein @misc-Eintrag mit Titel. Je Datei eine Zeile:
  <datei>: Quelle <id>
  <datei>: <hinweis>          (zusätzlich je Hinweis: Titel oder Autoren passen nicht zum PDF, Metadaten fehlen)
  <datei>: schon vorhanden (Quelle <id>)
  <datei>: <grund>
Exit 1, wenn eine Datei scheiterte.
TXT
}

link=
doi=
titel=
projektdatei=
# Weitere Formularfelder für Quellen ohne DOI, je als „name=wert“.
angaben=()
dateien=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) hilfe; exit 0 ;;
    --doi) [ $# -ge 2 ] || { echo "--doi braucht einen Wert" >&2; exit 2; }; doi=$2; shift 2 ;;
    --titel) [ $# -ge 2 ] || { echo "--titel braucht einen Wert" >&2; exit 2; }; titel=$2; shift 2 ;;
    --projektdatei) [ $# -ge 2 ] || { echo "--projektdatei braucht einen Wert" >&2; exit 2; }; projektdatei=$2; shift 2 ;;
    --autoren|--jahr|--art|--institution|--url)
      [ $# -ge 2 ] || { echo "$1 braucht einen Wert" >&2; exit 2; }; angaben+=("${1#--}=$2"); shift 2 ;;
    *)
      if [ -z "$link" ]; then link=$1; else dateien+=("$1"); fi
      shift ;;
  esac
done

if [ -z "$link" ] || [ ${#dateien[@]} -eq 0 ]; then
  hilfe >&2
  exit 2
fi
if [ -n "$projektdatei" ] && [ ${#dateien[@]} -ne 1 ]; then
  echo "--projektdatei gilt für genau eine Datei" >&2
  exit 2
fi

antwort=$(mktemp "${TMPDIR:-/tmp}/spur-hochladen.XXXXXX") || exit 1
trap 'rm -f "$antwort"' EXIT

feld() {
  tr -d '\n' < "$antwort" | sed -n "s/.*\"$1\": *\"\\([^\"]*\\)\".*/\\1/p"
}

rc=0
for pfad in "${dateien[@]}"; do
  if [ ! -f "$pfad" ]; then
    echo "$pfad: Datei nicht gefunden"
    rc=1
    continue
  fi
  # In Anführungszeichen, damit curl Komma, Semikolon und Anführungszeichen im Namen nicht als Syntax liest.
  q=${pfad//\\/\\\\}
  q=${q//\"/\\\"}
  args=(-F "datei=@\"$q\"")
  [ -n "$doi" ] && args+=(--form-string "doi=$doi")
  [ -n "$titel" ] && args+=(--form-string "titel=$titel")
  [ -n "$projektdatei" ] && args+=(--form-string "projektdatei=$projektdatei")
  for angabe in ${angaben[@]+"${angaben[@]}"}; do args+=(--form-string "$angabe"); done
  : > "$antwort"
  if ! code=$(curl -sS -o "$antwort" -w '%{http_code}' "${args[@]}" "$link" 2>&1); then
    echo "$pfad: Upload fehlgeschlagen ($(printf '%s' "$code" | tail -n 1))"
    rc=1
    continue
  fi
  status=$(feld status)
  case "$code:$status" in
    200:angelegt)
      if [ -n "$projektdatei" ]; then echo "$pfad: Datei $(feld pfad)"; continue; fi
      echo "$pfad: Quelle $(feld quelle_id)"
      for name in hinweis autoren_hinweis metadaten_hinweis; do
        hinweis=$(feld "$name")
        [ -z "$hinweis" ] || echo "$pfad: $hinweis"
      done ;;
    200:vorhanden) echo "$pfad: schon vorhanden (Quelle $(feld quelle_id))"; ;;
    200:abgelehnt) echo "$pfad: $(feld grund)"; rc=1 ;;
    *)
      grund=$(feld detail)
      [ -n "$grund" ] || grund=$(feld fehler)
      echo "$pfad: ${grund:-unerwartete Antwort (HTTP $code)}"
      rc=1 ;;
  esac
done
exit $rc
